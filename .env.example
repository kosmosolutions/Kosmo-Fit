NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Pexels (recipe + workout-card images). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR-PEXELS-KEY

# Service role key — used ONLY by scripts/sync-card-images.mjs to upload images
# into the public `card-images` Storage bucket. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
