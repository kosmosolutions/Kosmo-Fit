NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Pexels (recipe + workout-card images). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR-PEXELS-KEY

# Service role key — used ONLY by scripts/sync-card-images.mjs to upload images
# into the public `card-images` Storage bucket. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# FatSecret Platform API (live recipe search in the "All recipes" tab).
# Register at https://platform.fatsecret.com, then whitelist 0.0.0.0/0 in the
# key's IP settings so Vercel's dynamic egress IPs can mint OAuth tokens.
FATSECRET_CLIENT_ID=YOUR-FATSECRET-CLIENT-ID
FATSECRET_CLIENT_SECRET=YOUR-FATSECRET-CLIENT-SECRET
